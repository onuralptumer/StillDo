<?xml version="1.0" encoding="UTF-8"?>
<!--
    The first frame the app shows: the mark, the wordmark under it, and one
    quiet line at the foot. Colours come from the asset catalog rather than
    being written in here, so the screen follows the phone into dark exactly
    as `src/theme.ts` does — the launch screen is the app's own palette, not
    the system's white.

    Nothing here can animate or read state; it is a still that the running app
    lands on top of, so it is deliberately the same weight as the header the
    app draws a frame later.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LaunchMark" translatesAutoresizingMaskIntoConstraints="NO" id="mrk-01-img">
                                <rect key="frame" x="148.5" y="366" width="96" height="96"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="96" id="mrk-w0-001"/>
                                    <constraint firstAttribute="height" constant="96" id="mrk-h0-001"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="wrd-01-lbl">
                                <rect key="frame" x="126" y="484" width="141" height="16"/>
                                <attributedString key="attributedText">
                                    <fragment content="THINKLIGHTER">
                                        <attributes>
                                            <font key="NSFont" size="13" name="HankenGrotesk-Medium" family="Hanken Grotesk"/>
                                            <color key="NSColor" name="LaunchInk"/>
                                            <real key="NSKern" value="1.3"/>
                                            <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="natural"/>
                                        </attributes>
                                    </fragment>
                                </attributedString>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ftr-01-lbl">
                                <rect key="frame" x="118" y="778" width="157" height="13"/>
                                <attributedString key="attributedText">
                                    <fragment content="CATCH IT BADLY">
                                        <attributes>
                                            <font key="NSFont" size="10" name="HankenGrotesk-Medium" family="Hanken Grotesk"/>
                                            <color key="NSColor" name="LaunchMute"/>
                                            <real key="NSKern" value="1"/>
                                            <paragraphStyle key="NSParagraphStyle" alignment="center" lineBreakMode="wordWrapping" baseWritingDirection="natural"/>
                                        </attributes>
                                    </fragment>
                                </attributedString>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="Bcu-3y-fUS"/>
                        <color key="backgroundColor" name="LaunchBackground"/>
                        <constraints>
                            <!-- The mark sits a little above the middle, where the
                                 eye already is, rather than dead centre. -->
                            <constraint firstItem="mrk-01-img" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="mrk-cx-001"/>
                            <constraint firstItem="mrk-01-img" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" constant="-40" id="mrk-cy-001"/>
                            <constraint firstItem="wrd-01-lbl" firstAttribute="top" secondItem="mrk-01-img" secondAttribute="bottom" constant="22" id="wrd-tp-001"/>
                            <constraint firstItem="wrd-01-lbl" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="wrd-cx-001"/>
                            <constraint firstItem="ftr-01-lbl" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="ftr-cx-001"/>
                            <constraint firstItem="Bcu-3y-fUS" firstAttribute="bottom" secondItem="ftr-01-lbl" secondAttribute="bottom" constant="28" id="ftr-bt-001"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="52" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="LaunchMark" width="96" height="96"/>
        <namedColor name="LaunchBackground">
            <color red="0.98431372549019602" green="0.96862745098039216" blue="0.95294117647058818" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="LaunchInk">
            <color red="0.14509803921568629" green="0.10196078431372549" blue="0.066666666666666666" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
        <namedColor name="LaunchMute">
            <color red="0.41960784313725491" green="0.34901960784313724" blue="0.28627450980392155" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
        </namedColor>
    </resources>
</document>
