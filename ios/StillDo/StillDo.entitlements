<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The container the widgets read their summary out of. It has to be on
	     both this target and the widget extension, or the write lands in the
	     app's own defaults and nothing ever sees it. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.org.reactjs.native.example.StillDo</string>
	</array>
</dict>
</plist>
