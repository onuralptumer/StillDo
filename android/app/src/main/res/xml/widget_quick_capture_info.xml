<?xml version="1.0" encoding="utf-8"?>
<!--
    Four cells across, one down: the three tiles need the width to stay
    readable, and nothing here wants the height.

    updatePeriodMillis is 0 on purpose. The app redraws these itself the moment
    what they show changes, and Android's own polling floor is half an hour of
    waking the device for a payload that has not moved.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="80dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_quick_capture"
    android:previewLayout="@layout/widget_quick_capture"
    android:description="@string/widget_quick_capture_description"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen" />
